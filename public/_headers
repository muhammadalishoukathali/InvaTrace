/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https: http://localhost:*; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), geolocation=(self), microphone=()

/models/invatrace-student33-v1/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *
  X-Content-Type-Options: nosniff

/assets/ort-wasm-*.wasm
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

# Offline-catalogue reference images are SHA-256 verified against the pack
# manifest, so any CDN-side re-encoding (Cloudflare Polish converting these to
# WebP, for instance) breaks the download for everyone. no-transform keeps the
# published bytes intact.
#
# Not immutable: photos are replaced in place at the same path, and a year-long
# immutable entry kept the old photo on screen for anyone who had already seen
# it. The app requests them with ?v=<content hash> (see
# build/reference-image-versions.ts) so a replaced photo is a new URL; this
# short revalidating policy covers any request that arrives without one.
/reference-images/*
  Cache-Control: public, max-age=3600, must-revalidate, no-transform
  X-Content-Type-Options: nosniff
