{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://invatrace.local/schemas/approved-species.schema.json",
  "title": "InvaTrace approved Malaysian invasive plant catalogue",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "catalogue_version",
    "reviewed_at",
    "jurisdiction",
    "record_count",
    "records",
    "sources"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": "invatrace.approved-species.v1" },
    "catalogue_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "reviewed_at": { "type": "string", "format": "date" },
    "jurisdiction": { "const": "Malaysia" },
    "record_count": { "const": 32 },
    "records": {
      "type": "array",
      "minItems": 32,
      "maxItems": 32,
      "items": { "$ref": "#/$defs/record" }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/source" }
    }
  },
  "$defs": {
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "species_id",
        "scientific_name",
        "common_names",
        "malaysia_status",
        "evidence_source_ids",
        "evidence_summary",
        "habitats",
        "water_dispersed",
        "status_reviewed_at"
      ],
      "properties": {
        "species_id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "scientific_name": { "type": "string", "minLength": 1 },
        "accepted_scientific_name": { "type": "string", "minLength": 1 },
        "common_names": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "malaysia_status": { "const": "Present" },
        "evidence_source_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "evidence_summary": { "type": "string", "minLength": 1 },
        "habitats": { "type": "array", "minItems": 1, "items": { "enum": ["terrestrial", "freshwater"] } },
        "water_dispersed": { "type": "boolean" },
        "status_reviewed_at": { "type": "string", "format": "date" },
        "dispersal_modes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["water"] }
        },
        "dispersal_source_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "dispersal_reviewed_at": { "type": "string", "format": "date" }
      },
      "allOf": [
        {
          "description": "A dispersal trait must always ship with its evidence: any record that declares dispersal_modes must also carry a non-empty dispersal_source_ids array and a dispersal_reviewed_at date.",
          "if": { "required": ["dispersal_modes"] },
          "then": { "required": ["dispersal_source_ids", "dispersal_reviewed_at"] }
        },
        {
          "description": "Every species flagged water_dispersed=true must expose the sourced trait so the direction-aware pipeline can only trust records that carry water in dispersal_modes together with at least one source.",
          "if": { "properties": { "water_dispersed": { "const": true } }, "required": ["water_dispersed"] },
          "then": {
            "required": ["dispersal_modes", "dispersal_source_ids", "dispersal_reviewed_at"],
            "properties": { "dispersal_modes": { "contains": { "const": "water" } } }
          }
        }
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "title", "publisher", "url", "accessed"],
      "properties": {
        "source_id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "publisher": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" },
        "accessed": { "type": "string", "format": "date" }
      }
    }
  }
}
