{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://invatrace.local/schemas/plant-status.schema.json",
  "title": "InvaTrace plant status catalogue",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "catalogue_version",
    "model_version",
    "last_reviewed",
    "class_count",
    "records",
    "sources"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "type": "string", "const": "invatrace.catalogue.plant-status.v1" },
    "catalogue_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "model_version": { "type": "string", "minLength": 1 },
    "last_reviewed": { "type": "string", "format": "date" },
    "class_count": { "type": "integer", "minimum": 1 },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/record" }
    },
    "sources": {
      "type": "array",
      "items": { "$ref": "#/$defs/source" }
    }
  },
  "$defs": {
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "species_id",
        "model_label",
        "class_index",
        "scientific_name",
        "ui_state",
        "general_information",
        "safety_message",
        "status_source_ids",
        "status_reviewed_at",
        "report_eligible"
      ],
      "properties": {
        "species_id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "model_label": { "type": "string", "pattern": "^[a-z0-9]+(_[a-z0-9]+)*$" },
        "class_index": { "type": "integer", "minimum": 0 },
        "scientific_name": { "type": "string", "minLength": 1 },
        "common_name": { "type": "string" },
        "ui_state": {
          "type": "string",
          "enum": ["invasive", "information_only", "status_uncertain"]
        },
        "general_information": { "type": "string", "minLength": 1 },
        "safety_message": { "type": "string", "minLength": 1 },
        "status_source_ids": {
          "type": "array",
          "items": { "type": "string" }
        },
        "status_reviewed_at": { "type": "string", "format": "date" },
        "report_eligible": { "type": "boolean" }
      },
      "allOf": [
        {
          "if": { "properties": { "ui_state": { "const": "invasive" } } },
          "then": {
            "properties": {
              "status_source_ids": { "minItems": 1 },
              "report_eligible": { "const": true }
            }
          }
        },
        {
          "if": { "properties": { "ui_state": { "not": { "const": "invasive" } } } },
          "then": {
            "properties": { "report_eligible": { "const": false } }
          }
        }
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "title", "publisher", "url", "accessed"],
      "properties": {
        "source_id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "publisher": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" },
        "accessed": { "type": "string", "format": "date" }
      }
    }
  }
}
