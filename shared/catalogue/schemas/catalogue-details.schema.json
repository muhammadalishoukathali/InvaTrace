{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://invatrace.local/schemas/catalogue-details.schema.json",
  "title": "InvaTrace reviewed catalogue details",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "catalogue_version", "reviewed_at", "record_count", "sources", "records"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": "invatrace.catalogue.details.v1" },
    "catalogue_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "reviewed_at": { "type": "string", "format": "date" },
    "record_count": { "const": 32 },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "title", "publisher", "url", "accessed", "reuse_status"],
        "properties": {
          "source_id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)+$" },
          "title": { "type": "string", "minLength": 3 },
          "publisher": { "type": "string", "minLength": 2 },
          "url": { "type": "string", "format": "uri" },
          "accessed": { "type": "string", "format": "date" },
          "reuse_status": { "type": "string", "minLength": 10 }
        }
      }
    },
    "records": {
      "type": "array",
      "minItems": 32,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["species_id", "identifying_characteristics", "typical_habitat", "documented_impacts", "safe_response_guidance", "source_ids", "reviewed_at"],
        "properties": {
          "species_id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)+$" },
          "identifying_characteristics": { "type": "string", "minLength": 20 },
          "typical_habitat": { "type": "string", "minLength": 15 },
          "documented_impacts": { "type": "string", "minLength": 20 },
          "safe_response_guidance": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 15 }
          },
          "source_ids": {
            "type": "object",
            "additionalProperties": false,
            "required": ["identification", "habitat", "impacts", "guidance"],
            "properties": {
              "identification": { "$ref": "#/$defs/sourceIds" },
              "habitat": { "$ref": "#/$defs/sourceIds" },
              "impacts": { "$ref": "#/$defs/sourceIds" },
              "guidance": { "$ref": "#/$defs/sourceIds" }
            }
          },
          "reviewed_at": { "type": "string", "format": "date" }
        }
      }
    }
  },
  "$defs": {
    "sourceIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 3 }
    }
  }
}
