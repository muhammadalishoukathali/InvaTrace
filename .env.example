# Public frontend build configuration. Never place secrets in VITE_ variables.
VITE_API_BASE_URL=http://localhost:8000
VITE_MODEL_BASE_URL=/models/invatrace-student33-v1
# Leave these unset to use the default OpenFreeMap basemap (no key needed).
# Do not point them at tile.openstreetmap.org - it blocks apps with a 403 grid.
# VITE_MAP_STYLE_URL=https://api.maptiler.com/maps/streets-v2/style.json?key=YOUR_KEY
# VITE_MAP_TILE_URL=https://your-provider/{z}/{x}/{y}.png?key=YOUR_KEY
# VITE_MAP_TILE_ATTRIBUTION=© MapTiler © OpenStreetMap contributors
VITE_RELEASE_ID=dev
VITE_ENABLE_MOCKS=true
VITE_ENABLE_FAKE_MODEL=false
VITE_ENABLE_REAL_MODEL=true
VITE_HTTPS=false
