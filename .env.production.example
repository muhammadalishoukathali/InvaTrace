# AC Phase 5 - production frontend env template.
# Copy to `.env.production` (or configure at build time) before running
# `npm run build` for a real deployment. Every VITE_ value is baked into
# the bundle; keep secrets out. Any secret material belongs in the FastAPI
# process env (see render.yaml), never here.

# Points at the deployed FastAPI service. Do NOT trailing-slash.
VITE_API_BASE_URL=https://invatrace-api.example.com

# AC Phase 5 - mocks and fake models must be disabled in production so a
# published build cannot silently answer requests from MSW or synthesize
# classifier output. Both flags are checked at boot in src/main.tsx and
# src/features/scan/plant-model-adapter.ts.
VITE_ENABLE_MOCKS=false
VITE_ENABLE_FAKE_MODEL=false
VITE_ENABLE_REAL_MODEL=true

# Explicit CORS origin (used by the API service via CORS_ORIGINS). Keep
# this in sync with the frontend hosting URL - the FastAPI settings guard
# refuses `*` in production (backend/app/config.py production_safety).
# The frontend does not read this value itself; it lives here as a
# reminder for whoever provisions the environment.
FRONTEND_ORIGIN=https://invatrace.example.com

# Optional overrides. Leave commented to fall back to defaults baked into
# vite.config.ts / MapLibre.
# VITE_MAP_TILE_URL=https://tiles.example.com/{z}/{x}/{y}.png
# VITE_MAP_TILE_ATTRIBUTION=© Your tile provider
# VITE_RELEASE_ID=2026.09.02-1
# VITE_MODEL_MANIFEST_URL=/models/model-manifest.json
# VITE_HTTPS=true
