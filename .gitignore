# Environment files. The .example ones are meant to be committed; a real
# .env never is, so ignore everything and add the safe ones back.
.env*
!.env.example
!.env.production.example
!.env.model-test
.cloudflare-pages.env

# Secrets and archives that should never end up in a public repo.
*.pem
*.key
*.p12
*.pfx
*.docx
*.pdf
*.zip
*.rar

# Editor and OS noise
.DS_Store
Thumbs.db
.idea
.vscode

# Test and build output
test-results
coverage/
