#!/bin/sh
# Require a nonempty commit message and preserve the supplied authorship.
# Recorded commit metadata is checked separately before publication.

msg_file="$1"
[ -f "$msg_file" ] || exit 0

if ! LC_ALL=C grep -q '[^[:space:]]' "$msg_file"; then
  printf '%s\n' 'commit rejected: message must not be empty' >&2
  exit 1
fi

exit 0
